AMALIA_DATABASE=/var/lib/amalia/amalia.db
AMALIA_LOG=/var/log/amalia/amalia-api.log
AMALIA_AUTH_MODE=oidc
AMALIA_OIDC_ISSUER=https://ilona.example.invalid/realms/amalia
AMALIA_OIDC_AUDIENCE=amalia-api
# AMALIA_OIDC_JWKS_URL=https://ilona.example.invalid/realms/amalia/protocol/openid-connect/certs
AMALIA_DELETION_MODE=soft
AMALIA_MAX_ENTRY_LENGTH=10000
AMALIA_ALLOWED_ORIGINS=

# For an existing Kerberos/SPNEGO reverse proxy, use proxy mode and place a long
# random value in both this file and the additive proxy location. Never expose it
# to clients or commit it to source control.
# AMALIA_AUTH_MODE=proxy
# AMALIA_PROXY_SHARED_SECRET=REPLACE_FROM_SECRET_MANAGER
